erDiagram
    DEPARTMENTS ||--o{ USERS : "belongs to"
    DEPARTMENTS ||--o{ EVENTS : "organizes"
    SEMESTERS ||--o{ FINES : "scopes"
    USERS ||--o{ ATTENDANCES : "records"
    USERS ||--o{ FINES : "incurs"
    USERS ||--o{ SURVEY_RESPONSES : "submits"
    USERS ||--o{ ATTENDANCES : "verifies"
    EVENTS ||--o{ EVENT_SESSIONS : "has"
    EVENT_SESSIONS ||--o{ ATTENDANCES : "records"
    EVENTS ||--o{ ATTENDANCES : "has"
    EVENTS ||--o{ FINES : "generates"
    EVENTS ||--o| SURVEYS : "requires"
    SURVEYS ||--o{ SURVEY_QUESTIONS : "contains"
    SURVEY_QUESTIONS ||--o{ SURVEY_RESPONSES : "collects"

    USERS {
        bigint id PK
        string name
        string username
        string password
        bigint department_id FK
        string rfid_uid
        string year_level
        boolean is_active
        string remember_token
        timestamps created_at_updated_at
    }

    DEPARTMENTS {
        bigint id PK
        string name
        string code UK
        timestamp archived_at "nullable; archived, never deleted"
        timestamps created_at_updated_at
    }

    EVENTS {
        bigint id PK
        bigint department_id FK
        string name
        json year_levels "null = all year levels"
        datetime start_time
        datetime end_time
        decimal absent_fine "0 = no fine"
        decimal late_fine "0 = no fine"
        decimal missed_in_fine "0 = no fine"
        decimal missed_out_fine "0 = no fine"
        boolean requires_survey
        boolean fines_processed
        timestamps created_at_updated_at
    }

    ATTENDANCES {
        bigint id PK
        bigint event_id FK
        bigint event_session_id FK "unique with user_id"
        bigint user_id FK
        string status "present, late, absent or missed_in"
        timestamp time_in_at
        timestamp time_out_at
        string photo_path
        bigint verified_by_id FK
        timestamps created_at_updated_at
    }

    EVENT_SESSIONS {
        bigint id PK
        bigint event_id FK
        string name "morning, afternoon or evening"
        datetime starts_at
        datetime ends_at
        timestamps created_at_updated_at
    }

    FINES {
        bigint id PK
        bigint user_id FK
        bigint event_id FK "nullable"
        bigint semester_id FK "nullable"
        decimal amount
        enum status
        text reason
        timestamps created_at_updated_at
    }

    SEMESTERS {
        bigint id PK
        string name
        date starts_at
        timestamps created_at_updated_at
    }

    SURVEYS {
        bigint id PK
        bigint event_id FK
        string title
        text description
        timestamps created_at_updated_at
    }

    SURVEY_QUESTIONS {
        bigint id PK
        bigint survey_id FK
        text question_text
        string type
        timestamps created_at_updated_at
    }

    SURVEY_RESPONSES {
        bigint id PK
        bigint survey_question_id FK
        bigint user_id FK
        text answer
        timestamps created_at_updated_at
    }
